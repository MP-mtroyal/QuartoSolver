from Affine4Game import Affine4Game
from AglCannon import AglCannon
from QuartoDataTypes import *
from depthSaver import DepthSaver
from InfoPlotting import LoadingBar
import os

# ------------------------------------------------------------
# Loads solved board hashes and their associated solution strings
# from a .txt file (generated by DepthSaver).
# 
# Returns:
#   A dictionary mapping board hash → solution string
#   Example: {123456789: "AD2", ...}
# ------------------------------------------------------------
def parse_solutions(file_path):
    loader = DepthSaver()
    loader.loadGames(fileName=os.path.basename(file_path), path=os.path.dirname(file_path) + "/")
    return dict(zip(loader.hashes, loader.solutions))

# ------------------------------------------------------------
# Loads all unsolved board hashes from depth input files.
# This includes:
#   - Agl_Level_<d>_unsolved.txt
#   - Agl_Level_<d>_unsolved_chunk#.txt (optional chunks)
#
# Returns:
#   A flat list of board hashes [hash1, hash2, ...]
# ------------------------------------------------------------
def load_hashes_from_files(folder, depth):
    hashes = []
    base_file = os.path.join(folder, f"Agl_Level_{depth}_unsolved.txt")
    if os.path.exists(base_file):
        loader = DepthSaver()
        loader.loadGames(fileName=os.path.basename(base_file), path=os.path.dirname(base_file) + "/")
        hashes.extend(loader.hashes)

    chunk_num = 0
    while True:
        chunk_file = os.path.join(folder, f"Agl_Level_{depth}_unsolved_chunk{chunk_num}.txt")
        if not os.path.exists(chunk_file):
            break
        loader = DepthSaver()
        loader.loadGames(fileName=os.path.basename(chunk_file), path=os.path.dirname(chunk_file) + "/")
        hashes.extend(loader.hashes)
        chunk_num += 1

    return hashes

# ------------------------------------------------------------
# Reports how many parent hashes match directly with child
# solved hashes and how many require simulation.
# ------------------------------------------------------------
def log_match_breakdown(depth_solutions, parent_hashes):
    solved_hashes = set(depth_solutions.keys())
    parent_hash_set = set(parent_hashes)

    direct_matches = solved_hashes.intersection(parent_hash_set)
    simulated_required = parent_hash_set - direct_matches

    print(f"\nMatch Breakdown:")
    print(f"Direct matches     : {len(direct_matches)}")
    print(f"Require simulation : {len(simulated_required)}")
    print(f"Total parent boards: {len(parent_hash_set)}")

# ------------------------------------------------------------
# Main backpropagation driver that processes all levels from
# deepest_depth down to shallowest_depth.
#
# At each depth level d:
#   - Loads solved boards from Agl_Level_d_solved.txt
#   - Loads parent hashes from depth d-1 unsolved files
#   - Matches child to parent in two phases:
#       1. Direct hash match
#       2. Simulated children via piece/square moves + canonization
#   - Backpropagates the best child solution string (lowest score)
#     to the parent board hash at depth d-1
#
# Results:
#   - Saves backpropagated solutions: Agl_Level_<d-1>_backprop_solved.txt
#   - Saves unmatched solved hashes: Agl_Level_<d>_orphans.txt
# ------------------------------------------------------------
def backpropagate_all(folder, deepest_depth, shallowest_depth):
    cannonizer = AglCannon()

    # Work backward from the deepest depth down to the shallowest one (inclusive)
    for d in range(deepest_depth, shallowest_depth, -1):
        print(f"\nBackpropagating from depth {d} to depth {d-1}...")

        # Load the solved boards at depth d
        solved_file = os.path.join(folder, f"Agl_Level_{d}_solved.txt")
        if not os.path.exists(solved_file):
            print(f"  Skipping depth {d}, no solved file found.")
            continue

        depth_solutions = parse_solutions(solved_file)  # {hash: solution_str}
        depth_solution_hashes = set(depth_solutions.keys())

        # Load the unsolved boards from depth d-1
        parent_hashes = load_hashes_from_files(folder, d - 1)
        parent_hash_set = set(parent_hashes)

        best_solutions = {}  # Will store best solution for each depth-(d-1) board

        # Load previously solved boards at depth d-1 using DepthSaver
        prev_solved_file = os.path.join(folder, f"Agl_Level_{d-1}_solved.txt")
        if os.path.exists(prev_solved_file):
            saver = DepthSaver()
            saver.loadGames(fileName=os.path.basename(prev_solved_file), path=os.path.dirname(prev_solved_file) + "/")
            for h, s in zip(saver.hashes, saver.solutions):
                if s is not None:
                    prev_score = ord(s[2]) - 49
                    if (h not in best_solutions) or prev_score < (ord(best_solutions[h][2]) - 49):
                        best_solutions[h] = s


        log_match_breakdown(depth_solutions, parent_hashes)

        # Direct Matches (identical hash in both depths)
        direct_matched = depth_solution_hashes.intersection(parent_hash_set)
        for direct_hash in direct_matched:
            child_sol = depth_solutions[direct_hash]
            score = ord(child_sol[2]) - 49  # Extract integer score from solution string
            if (direct_hash not in best_solutions) or score > (ord(best_solutions[direct_hash][2]) - 49):
                best_solutions[direct_hash] = child_sol  # Assign best scoring solution

        # Generate children from unmatched parent boards
        remaining_solved_hashes = depth_solution_hashes - direct_matched
        child_links_found = set()

        for parent_hash in parent_hashes:
            if parent_hash in best_solutions:
                continue  # Already handled as a direct match

            # Load the parent game
            parent_game = Affine4Game(undoMemLength=0)
            parent_game.loadFromHash(parent_hash)

            for piece in parent_game.getRemainingPieces():
                if not parent_game.selectPiece(piece):
                    continue  # Skip if piece selection failed

                for square in parent_game.getAvaliableSquares():
                    if not parent_game.placePiece(piece, square):
                        continue  # Skip if placement failed

                    # Copy the game after the move to safely canonize
                    temp_game = Affine4Game()
                    temp_game.loadFromHash(parent_game.hashBoard())

                    # Canonize the resulting child board
                    child_game = cannonizer.cannonizeGame(temp_game)
                    child_hash = child_game.hashBoard()

                    # Check if this child board was solved at depth d
                    if child_hash in remaining_solved_hashes:
                        child_sol = depth_solutions[child_hash]
                        score = ord(child_sol[2]) - 49
                        if (parent_hash not in best_solutions) or score < (ord(best_solutions[parent_hash][2]) - 49):
                            best_solutions[parent_hash] = child_sol  # Use best-scoring child
                        child_links_found.add(child_hash)  # Track it so it's not orphaned

                    parent_game.removePiece(square) # Undo the move on the original parent board
                parent_game.deselectAll()  # Deselect the piece before moving to the next one


        # Save parent boards at depth d-1 without any matching solved child
        parents_without_solutions = list(parent_hash_set - set(best_solutions.keys()))

        if parents_without_solutions:
            dummy_sols = ['!' for _ in parents_without_solutions]
            saver = DepthSaver()
            saver.hashes = parents_without_solutions
            saver.solutions = dummy_sols
            saver.saveSolution(f"Agl_Level_{d-1}_unsolved_childless.txt", path=folder + '/')
            print(f"{len(parents_without_solutions)} parent boards remained unsolved and saved as Agl_Level_{d-1}_unsolved_childless.txt.")

        # Save child boards at depth d without any parent to append path to
        unlinked_hashes = list(remaining_solved_hashes - child_links_found)
        if unlinked_hashes:
            saver = DepthSaver()
            saver.hashes = unlinked_hashes
            saver.solutions = [sol + ' # Parentless' for sol in saver.solutions]
            saver.saveSolution(f"Agl_Level_{d}_parentless.txt", path=folder + '/')
            print(f"{len(unlinked_hashes)} child boards had no matching parent and saved as Agl_Level_{d}_parentless.txt.")

        # Save Solutions at Each Depth
        # if best_solutions:
        #     saver = DepthSaver()
        #     saver.hashes = list(best_solutions.keys())
        #     saver.solutions = list(best_solutions.values())
        #     saver.saveSolution(f"Agl_Level_{d-1}_backprop_solved.txt", path=folder + '/')
        #     print(f"  {len(best_solutions)} parent boards solved and saved.")

        # Save final output only at shallowest depth
        if d - 1 == shallowest_depth:
            if best_solutions:
                saver = DepthSaver()
                saver.hashes = list(best_solutions.keys())
                saver.solutions = list(best_solutions.values())
                saver.saveSolution(f"Agl_Level_{d-1}_backprop_solved.txt", path=folder + '/')
                print(f"Final depth {d-1} solved output contained {len(best_solutions)} boards.")


# Run backpropagation from deepest_depth up to shallowest_depth, storing best solutions at each level
backpropagate_all(folder="./Solved_Unsolved", deepest_depth=4, shallowest_depth=3) 
