# ------------------------------------------------------------
# Loads solved board hashes and their associated solution strings
# from a .txt file (generated by DepthSaver).
# 
# Returns:
#   A dictionary mapping board hash → solution string
#   Example: {123456789: "AD2", ...}
# ------------------------------------------------------------
def parse_solutions(file_path):
    print(f"Parsing {file_path}...")
    loader = DepthSaver()
    loader.loadGames(fileName=os.path.basename(file_path), path=os.path.dirname(file_path) + "/")
    return dict(zip(loader.hashes, loader.solutions))

# ------------------------------------------------------------
# Combines all solution files for a given depth into one file.
#
# Specifically, this function:
#   - Loads existing solutions from Agl_Level_<depth>_solved.txt
#   - Merges additional valid solutions from:
#       • Agl_Level_<depth>_chunk*_to_*.txt (valid only)
#       • Agl_Level_<depth>_chunk*_CudaSolved*.txt (may include partials)
#   - Ensures no duplicate solutions (preserves existing entries)
#   - Saves the final combined result into Agl_Level_<depth}_solved.txt
#
# Args:
#   folder (str): Directory containing the solution files
#   depth (int): Depth level of the solution files to combine
#
# Returns:
#   None. Saves merged solutions to disk.
# ------------------------------------------------------------
def combine_solution_files(folder, depth):
    print("Combining solution files...")
    combined_solutions = {}

    # Load existing solutions first (if they exist)
    solved_file = os.path.join(folder, f"Agl_Level_{depth}_solved.txt")
    if os.path.exists(solved_file):
        existing_loader = DepthSaver()
        existing_loader.loadGames(fileName=os.path.basename(solved_file), path=folder + "/")
        combined_solutions.update(dict(zip(existing_loader.hashes, existing_loader.solutions)))

    # First, load _to_ files (they only contain valid solutions)
    for file in sorted(os.listdir(folder)):
        if file.startswith(f"Agl_Level_{depth}_chunk") and "_to_" in file:
            loader = DepthSaver()
            loader.loadGames(fileName=file, path=folder + "/")
            for h, s in zip(loader.hashes, loader.solutions):
                if h not in combined_solutions:
                    combined_solutions[h] = s

    # Then, load CudaSolved files (some may have '-') but don't overwrite existing entries
    for file in sorted(os.listdir(folder)):
        if file.startswith(f"Agl_Level_{depth}_chunk") and "CudaSolved" in file:
            loader = DepthSaver()
            loader.loadGames(fileName=file, path=folder + "/")
            for h, s in zip(loader.hashes, loader.solutions):
                if h not in combined_solutions:
                    combined_solutions[h] = s

    # Save the merged solutions
    saver = DepthSaver()
    saver.hashes = list(combined_solutions.keys())
    saver.solutions = list(combined_solutions.values())
    saver.saveSolution(f"Agl_Level_{depth}_solved.txt", path=folder + "/")

    print(f"Merged solutions saved to {solved_file}. Total unique solved boards: {len(combined_solutions)}")

# ------------------------------------------------------------
# Loads all unsolved board hashes from depth input files.
# This includes:
#   - Agl_Level_<d>_unsolved.txt
#   - Agl_Level_<d>_unsolved_chunk#.txt (optional chunks)
#
# Returns:
#   A flat list of board hashes [hash1, hash2, ...]
# ------------------------------------------------------------
def load_hashes_from_files(folder, depth):
    print("Loading unsolved files...")
    hashes = []
    base_file = os.path.join(folder, f"Agl_Level_{depth}_unsolved.txt")
    if os.path.exists(base_file):
        loader = DepthSaver()
        loader.loadGames(fileName=os.path.basename(base_file), path=os.path.dirname(base_file) + "/")
        hashes.extend(loader.hashes)

    chunk_num = 0
    while True:
        chunk_file = os.path.join(folder, f"Agl_Level_{depth}_unsolved_chunk{chunk_num}.txt")
        if not os.path.exists(chunk_file):
            break
        loader = DepthSaver()
        loader.loadGames(fileName=os.path.basename(chunk_file), path=os.path.dirname(chunk_file) + "/")
        hashes.extend(loader.hashes)
        chunk_num += 1

    return hashes

# ------------------------------------------------------------
# Reports how many parent hashes match directly with child
# solved hashes and how many require simulation.
# ------------------------------------------------------------
def log_match_breakdown(depth_solutions, parent_hashes):
    solved_hashes = set(depth_solutions.keys())
    parent_hash_set = set(parent_hashes)

    direct_matches = solved_hashes.intersection(parent_hash_set)
    simulated_required = parent_hash_set - direct_matches

    print(f"\nMatch Breakdown:")
    print(f"Direct matches     : {len(direct_matches)}")
    print(f"Require simulation : {len(simulated_required)}")
    print(f"Total parent boards: {len(parent_hash_set)}")

# ------------------------------------------------------------
# Helper to find the score of a solution string based on whos
# turn it is.
# ------------------------------------------------------------
def find_score(solution:str) -> int:
    if len(solution) % 2 == 0:
        return print("Not odd length path.")
    if solution[-1] != '2':
        return print("Invalid board.")

    if (len(solution) // 2) % 2 == 1:
        return 1
    else:
        return -1
    
# ==================== Best piece selection functions =======================================
def traitsInCommon(p1, p2):
    commonTraits =  bin(p1 & p2).count('1')
    commonTraits += bin((p1 ^ 15) & (p2 ^ 15)).count('1')
    return commonTraits

# Finds best piece that could be placed which is invariant to 'toPlace' if the current
# pieces on the board are 'placed'

def bestPiece(game: Affine4Game, placed: list[int], toPlace:int):
    for i in range(toPlace):
        if game.remainingPieces[i] < 1:
            continue
        for n in range(len(placed)):
            # End loop early if current pieces shares a different number of traits
            # in common with the placed piece
            if traitsInCommon(i, placed[n]) != traitsInCommon(toPlace, placed[n]):
                break
        # If the loop didn't end early, return the current piece
        else:
            return i
    return toPlace
